{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kajisho5/zero-exec-triage/schemas/triage-input.schema.json",
  "title": "ZET triage-input.json",
  "description": "Input of ZET (decision layer). findings is validated separately with the ZES findings.schema.json (schemas/vendor, pinned version). Unknown fields are rejected (strict).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings", "policy", "skillpact_policy"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "findings": { "type": "object", "description": "The whole ZES findings.json" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlines", "decision_window_days", "approvers"],
      "properties": {
        "deadlines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
          "properties": {
            "CRITICAL": { "$ref": "#/$defs/days" },
            "HIGH": { "$ref": "#/$defs/days" },
            "MEDIUM": { "$ref": "#/$defs/days" },
            "LOW": { "$ref": "#/$defs/days" },
            "INFO": { "$ref": "#/$defs/days" }
          }
        },
        "decision_window_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "approvers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/person" } },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roots"],
          "description": "The scan scope being approved (becomes plan.scope; GER G-9). roots is the ZES --root, home is ZES_HOME. When findings 1.1 has scan_roots, those are used as roots. Actions that change files need one of the two",
          "properties": {
            "roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
            "home": { "type": ["string", "null"], "pattern": "^/" }
          }
        }
      }
    },
    "skillpact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l3_trusted"],
      "properties": {
        "l3_trusted": { "type": "boolean", "description": "true is rejected as a contract violation (an L3 signature is not a basis for trust)" },
        "diff_anomaly_threshold": { "type": "number", "minimum": 0, "maximum": 1, "description": "Reserved (not implemented). zet validate rejects it (the ZES diff_anomaly is a boolean, so there is no value to apply a threshold to)" },
        "destructive_requires_human": { "type": "boolean", "description": "Reserved (not implemented). zet validate rejects it (ZET cannot tell whether the decision maker is a person or an AI)" }
      }
    }
  },
  "$defs": {
    "days": { "type": "integer", "minimum": 0, "maximum": 3650 },
    "person": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$" }
  }
}
