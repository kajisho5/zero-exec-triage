{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kajisho5/zero-exec-triage/schemas/triage-input.schema.json",
  "title": "ZET triage-input.json",
  "description": "ZET（判断層）の入力。findings は ZES の findings.schema.json（schemas/vendor、版固定）で別途検証する。未知フィールドは拒否（strict）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings", "policy", "skillpact_policy"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "findings": { "type": "object", "description": "ZES findings.json 全体" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlines", "decision_window_days", "approvers"],
      "properties": {
        "deadlines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
          "properties": {
            "CRITICAL": { "$ref": "#/$defs/days" },
            "HIGH": { "$ref": "#/$defs/days" },
            "MEDIUM": { "$ref": "#/$defs/days" },
            "LOW": { "$ref": "#/$defs/days" },
            "INFO": { "$ref": "#/$defs/days" }
          }
        },
        "decision_window_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "approvers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/person" } }
      }
    },
    "skillpact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l3_trusted", "diff_anomaly_threshold", "destructive_requires_human"],
      "properties": {
        "l3_trusted": { "type": "boolean", "description": "true は契約違反として拒否する（L3 署名を信頼根拠にしない）" },
        "diff_anomaly_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "destructive_requires_human": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "days": { "type": "integer", "minimum": 0, "maximum": 3650 },
    "person": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$" }
  }
}
