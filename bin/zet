#!/usr/bin/env bash
# ZET launcher. Resolves the path without external commands (bash built-ins only) and runs
# python3 -I -S (ignores environment variables, site (including .pth files) and the current directory).
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
case "$SELF" in */*) ;; *) SELF="./$SELF" ;; esac
BIN_DIR="$(cd "${SELF%/*}" && pwd -P)"
exec python3 -I -S "${BIN_DIR%/*}/zet/__main__.py" "$@"
